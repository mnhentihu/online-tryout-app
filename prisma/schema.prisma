// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// USER & PROFILE
// ==========================================

model User {
  id        String   @id @db.Uuid
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile       UserProfile?
  subscriptions Subscription[]
  attempts      TryoutAttempt[]

  @@map("users")
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  name      String?  @db.VarChar(100)
  avatarUrl String?  @map("avatar_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ==========================================
// SUBSCRIPTION & REDEEM CODE
// ==========================================

model RedeemCode {
  id           String    @id @default(uuid()) @db.Uuid
  codeHash     String    @unique @map("code_hash") @db.VarChar(64)
  durationDays Int       @map("duration_days")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription?

  @@map("redeem_codes")
}

model Subscription {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  redeemCodeId String   @unique @map("redeem_code_id") @db.Uuid
  startsAt     DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime @map("ends_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemCode RedeemCode @relation(fields: [redeemCodeId], references: [id], onDelete: Restrict)

  @@index([userId, startsAt, endsAt])
  @@map("subscriptions")
}

// ==========================================
// LEARNING MATERIAL
// ==========================================

model LearningMaterial {
  id              String   @id @default(uuid()) @db.Uuid
  title           String   @db.VarChar(150)
  description     String?  @db.Text
  videoUrl        String   @map("video_url") @db.Text
  thumbnailUrl    String?  @map("thumbnail_url") @db.Text
  durationSeconds Int?     @map("duration_seconds")
  sortOrder       Int      @default(0) @map("sort_order")
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("learning_materials")
}

// ==========================================
// TRYOUT
// ==========================================

model Tryout {
  id              String   @id @default(uuid()) @db.Uuid
  title           String   @db.VarChar(150)
  description     String?  @db.Text
  durationMinutes Int      @map("duration_minutes")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  questions Question[]
  attempts  TryoutAttempt[]

  @@map("tryouts")
}

model Question {
  id           String @id @default(uuid()) @db.Uuid
  tryoutId     String @map("tryout_id") @db.Uuid
  questionText String @map("question_text") @db.Text
  sortOrder    Int    @default(0) @map("sort_order")

  tryout     Tryout             @relation(fields: [tryoutId], references: [id], onDelete: Cascade)
  statements QuestionStatement[]

  @@unique([tryoutId, sortOrder])
  @@map("questions")
}

model QuestionStatement {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  statement  String  @db.Text
  isTrue     Boolean @map("is_true")
  sortOrder  Int     @default(0) @map("sort_order")

  question Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@unique([questionId, sortOrder])
  @@map("question_statements")
}

// ==========================================
// TRYOUT ATTEMPT & ANSWERS
// ==========================================

model TryoutAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tryoutId    String    @map("tryout_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  score       Int?

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tryout  Tryout         @relation(fields: [tryoutId], references: [id], onDelete: Restrict)
  answers AttemptAnswer[]

  @@index([userId, tryoutId])
  @@map("tryout_attempts")
}

model AttemptAnswer {
  id          String  @id @default(uuid()) @db.Uuid
  attemptId   String  @map("attempt_id") @db.Uuid
  statementId String  @map("statement_id") @db.Uuid
  answer      Boolean

  attempt   TryoutAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  statement QuestionStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@unique([attemptId, statementId])
  @@map("attempt_answers")
}
